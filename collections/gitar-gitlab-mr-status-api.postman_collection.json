      "item": [
        {
          "id": "5c08497e-179e-4c5b-b199-07904ee03112",
          "name": "Get Gitar's blocking status for a GitLab MR",
          "request": {
            "name": "Get Gitar's blocking status for a GitLab MR",
            "description": {
              "content": "Returns the current Gitar blocking status for a GitLab merge request. Intended for use in CI pipelines: fail the job when `blocked == \"yes\"` and mark it required for merge.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "external",
                "gitlab",
                "mr_status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "project_id",
                  "value": "<long>",
                  "description": "(Required) GitLab project ID"
                },
                {
                  "disabled": false,
                  "key": "mr_iid",
                  "value": "<long>",
                  "description": "(Required) GitLab merge request IID"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "21b6d4d9-449c-4815-8ce1-b5a7312f7eca",
              "name": "MR blocking status returned successfully",
              "originalRequest": {
                "url": {
                  "path": [
